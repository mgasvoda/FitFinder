# FitFinder Chainlit Configuration
# Copy this file to .env and customize the values

# Data Storage Configuration
# For production deployment with persistent volumes, set this to your mounted volume path
# Example for production: DATA_PATH=/mnt/fitfinder
# For development, you can omit this (defaults to current directory)
# DATA_PATH=/path/to/persistent/storage

# Chainlit Authentication
CHAINLIT_AUTH_SECRET=your-chainlit-secret-key-here
CHAINLIT_ADMIN_USERNAME=admin
CHAINLIT_ADMIN_PASSWORD=fitfinder2024!

# Database
# If using default DATA_PATH, this will be: sqlite:///./fitfinder.db
# If using custom DATA_PATH, this will be: sqlite:///[DATA_PATH]/fitfinder.db
DATABASE_URL=sqlite:///./fitfinder.db

# AI/ML Service APIs
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Langfuse tracing (remove if not using)
# LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
# LANGFUSE_SECRET_KEY=your-langfuse-secret-key

# Chainlit server settings (optional - defaults are usually fine)
# CHAINLIT_HOST=0.0.0.0
# CHAINLIT_PORT=8001 